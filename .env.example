# ==============================================================================
# Healthcare AI Suite — Unified Environment Configuration
# ==============================================================================
# Copy this file to .env in the respective service directory before running.
# Backend: backend/.env
# Aura Routes: apps/aura-routes/.env.local
# NursePass: apps/nursepass/.env.local
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 1 — BACKEND SERVER
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://auraroutes.com,https://www.auraroutes.com,https://nursepass.com,https://www.nursepass.com,https://fmge.healthcare-suite.com,http://localhost:3000,http://localhost:3001

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 2 — SHARED DATABASE (PostgreSQL / Supabase)
# ONE database for all products. application_type column isolates product data.
# ──────────────────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 3 — REDIS (Caching & Background Tasks)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 4 — SUPABASE AUTH (ONE account, all products)
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 5 — AI ENGINE (Shared across all products)
# ──────────────────────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o

# Replicate (Testing & open-weights models: Llama-3, etc.)
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here


# ──────────────────────────────────────────────────────────────────────────────
# SECTION 6 — PAYMENTS (Shared Razorpay — all products)
# ──────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 7 — NOTIFICATIONS
# ──────────────────────────────────────────────────────────────────────────────
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@healthcare-suite.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_SENDER=Healthcare AI Suite <notifications@healthcare-suite.com>

# Resend (alternative transactional email)
RESEND_API_KEY=re_your_resend_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 8 — SECURITY
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-jwt-secret-key-here

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 9 — FRONTEND (All apps use these — prefix with NEXT_PUBLIC_)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.healthcare-suite.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 10 — FEATURE FLAGS
# ──────────────────────────────────────────────────────────────────────────────
ENABLE_NURSEPASS=true
ENABLE_FMGE=false
ENABLE_REDIS_CACHE=false
