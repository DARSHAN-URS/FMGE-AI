# See https://help.github.com/articles/ignoring-files/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Builds ────────────────────────────────────────────────────────────
.next/
out/
apps/*/out/
apps/*/.next/

# ── TypeScript Build Info ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/

# ── Database Files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
migration/archive/
apps/aura-routes/
apps/nursepass/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Coverage ─────────────────────────────────────────────────────────────────
coverage/
.coverage
htmlcov/

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep Dockerfiles, ignore build artifacts

# ── Railway / Vercel ──────────────────────────────────────────────────────────
.vercel
.railway
